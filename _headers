/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com https://www.facebook.com; connect-src 'self' https://www.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net https://stats.g.doubleclick.net https://www.facebook.com https://connect.facebook.net; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Apple Universal Links manifest. iOS fetches this to confirm the
# Atteste app may handle https://atteste.art/v/* URLs from NFC tag
# taps. Must be served as application/json, NO file extension.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# Android App Links manifest. Equivalent of AASA — Android verifies
# the SHA-256 cert fingerprint matches the installed app's signing
# certificate before auto-routing /v/* URLs into the app.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# Shared design-system stylesheet — immutable, cache-busted via ?v= query.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

# Shared scripts (consent manager) — immutable, cache-busted via ?v= query.
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
