<style>
/* ===== Landing v2 (2026-10-25) — bright gallery-white. Scoped under body.lp ===== */
body.lp{--ink:#1A1A2E;--ink2:#3b3b4f;--mute:#6b6b7d;--line:#e9e3d8;--cream:#FAF8F5;--paper:#fff;--gold:#C9A96E;--gold-d:#9A7B44;
  --r:22px;--max:1200px;background:var(--cream);color:var(--ink);font-family:Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
body.lp *{box-sizing:border-box}
.lp-wrap{max-width:var(--max);margin:0 auto;padding:0 28px}
.lp-eyebrow{font:600 12px/1 Inter;letter-spacing:.2em;text-transform:uppercase;color:var(--gold-d)}
.lp-h2{font:600 clamp(34px,4.6vw,58px)/1.06 'Playfair Display',Georgia,serif;letter-spacing:-.01em;margin:14px 0 0;color:var(--ink)}
.lp-h2 em,.lp-h1 em{font-style:italic;color:var(--gold-d);font-weight:500}
.lp-lede{font:400 clamp(17px,1.5vw,20px)/1.6 Inter;color:var(--ink2);max-width:640px;margin:18px 0 0}
.lp-btn{display:inline-flex;align-items:center;gap:10px;font:600 15px Inter;padding:15px 26px;border-radius:999px;text-decoration:none;transition:transform .2s,box-shadow .2s,background .2s}
.lp-btn:hover{transform:translateY(-1px)}
.lp-btn-dark{background:var(--ink);color:#fff;box-shadow:0 10px 30px rgba(26,26,46,.18)}
.lp-btn-gold{background:var(--gold);color:var(--ink)}
.lp-btn-line{border:1.5px solid rgba(26,26,46,.18);color:var(--ink);background:rgba(255,255,255,.6)}
.lp-reveal{opacity:0;transform:translateY(24px);transition:opacity .9s ease,transform .9s ease}
.lp-reveal.in{opacity:1;transform:none}

/* nav */
.lp-nav{position:fixed;inset:0 0 auto 0;z-index:50;transition:background .3s,box-shadow .3s,backdrop-filter .3s}
.lp-nav .lp-wrap{display:flex;align-items:center;justify-content:space-between;height:74px}
.lp-logo{font:600 26px 'Playfair Display',serif;color:var(--ink);text-decoration:none;letter-spacing:.01em}
.lp-logo span{color:var(--gold-d)}
.lp-links{display:flex;gap:28px;align-items:center;list-style:none;margin:0;padding:0}
.lp-links a{font:500 14.5px Inter;color:var(--ink);text-decoration:none;opacity:.85}
.lp-links a:hover{opacity:1}
.lp-links .lp-btn{opacity:1;padding:11px 20px;font-size:14px;color:#fff}
.lp-nav.scrolled{background:rgba(250,248,245,.86);backdrop-filter:saturate(1.4) blur(14px);box-shadow:0 1px 0 var(--line)}
.lp-burger{display:none;background:none;border:0;padding:8px;cursor:pointer}
.lp-burger span{display:block;width:22px;height:2px;background:var(--ink);margin:5px 0;border-radius:2px}

/* hero */
.lp-hero{position:relative;min-height:100svh;display:flex;align-items:flex-end;overflow:hidden;background:#efe9df}
.lp-hero video,.lp-hero .lp-hero-poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.lp-hero .v-mobile{display:none}
.lp-hero::after{content:"";position:absolute;inset:0;background:
  linear-gradient(90deg,rgba(250,248,245,.94) 0%,rgba(250,248,245,.82) 30%,rgba(250,248,245,.15) 62%,rgba(250,248,245,0) 80%),
  linear-gradient(0deg,rgba(250,248,245,.9) 0%,rgba(250,248,245,0) 34%)}
.lp-hero-in{position:relative;z-index:2;width:100%;padding:140px 0 72px}
.lp-hero-copy{max-width:640px}
.lp-h1{font:600 clamp(52px,8.2vw,112px)/.98 'Playfair Display',Georgia,serif;letter-spacing:-.02em;margin:18px 0 0;color:var(--ink)}
.lp-hero-sub{font:400 clamp(17px,1.6vw,21px)/1.55 Inter;color:var(--ink2);margin:22px 0 0;max-width:560px}
.lp-roles{display:inline-flex;gap:6px;margin:32px 0 0;padding:6px;border-radius:999px;background:rgba(255,255,255,.8);box-shadow:0 8px 30px rgba(26,26,46,.08);border:1px solid var(--line)}
.lp-roles button{font:600 14px Inter;border:0;background:none;color:var(--ink2);padding:11px 18px;border-radius:999px;cursor:pointer;transition:background .25s,color .25s}
.lp-roles button[aria-selected="true"]{background:var(--ink);color:#fff}
.lp-role-panel{margin-top:22px;min-height:118px}
.lp-role-panel[hidden]{display:none}
.lp-role-panel p{font:500 16px/1.5 Inter;color:var(--ink);margin:0 0 16px;max-width:520px}
.lp-badges{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.lp-badges img{height:46px;width:auto;display:block}
.lp-hero-note{font:400 12.5px Inter;color:var(--mute);margin-top:26px}
.lp-scroll{position:absolute;z-index:2;right:28px;bottom:28px;font:600 11px Inter;letter-spacing:.2em;text-transform:uppercase;color:var(--ink2);writing-mode:vertical-rl}

/* living strip */
.lp-strip{padding:96px 0 40px;overflow:hidden}
.lp-strip-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap}
.lp-marquee{margin-top:44px;display:flex;gap:18px;width:max-content;animation:lp-slide 70s linear infinite}
.lp-marquee:hover{animation-play-state:paused}
.lp-tile{width:220px;aspect-ratio:9/16;border-radius:18px;overflow:hidden;position:relative;background:#e9e3d8;box-shadow:0 18px 40px rgba(26,26,46,.12);flex:none}
.lp-tile video{width:100%;height:100%;object-fit:cover;display:block}
@keyframes lp-slide{to{transform:translateX(-50%)}}
.lp-strip-note{font:400 12.5px Inter;color:var(--mute);margin-top:18px}

/* pillars */
.lp-pillars{padding:110px 0}
.lp-pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:56px}
.lp-pillar{background:var(--paper);border:1px solid var(--line);border-radius:var(--r);padding:34px 30px;transition:transform .3s,box-shadow .3s}
.lp-pillar:hover{transform:translateY(-4px);box-shadow:0 22px 50px rgba(26,26,46,.08)}
.lp-verb{font:600 36px 'Playfair Display',serif;color:var(--ink)}
.lp-verb span{color:var(--gold)}
.lp-what{font:600 15px Inter;color:var(--gold-d);margin:6px 0 12px}
.lp-pillar p{font:400 15.5px/1.65 Inter;color:var(--ink2);margin:0}
.lp-pillar a{display:inline-block;margin-top:14px;font:600 14px Inter;color:var(--ink);text-decoration:none;border-bottom:1.5px solid var(--gold)}

/* role sections */
.lp-role{padding:70px 0}
.lp-role .lp-wrap{display:grid;grid-template-columns:1.05fr .95fr;gap:72px;align-items:center}
.lp-role.flip .lp-media{order:2}
.lp-media{position:relative;border-radius:28px;overflow:hidden;aspect-ratio:4/3;box-shadow:0 40px 80px rgba(26,26,46,.16);background:#e9e3d8}
.lp-media video{width:100%;height:100%;object-fit:cover;display:block}
.lp-media .lp-chip{position:absolute;left:18px;bottom:18px;background:rgba(255,255,255,.9);backdrop-filter:blur(8px);border-radius:999px;padding:9px 15px;font:600 12.5px Inter;color:var(--ink)}
.lp-role ul{list-style:none;padding:0;margin:26px 0 0}
.lp-role li{position:relative;padding:0 0 16px 30px;font:400 16px/1.6 Inter;color:var(--ink2)}
.lp-role li strong{color:var(--ink);font-weight:600}
.lp-role li::before{content:"";position:absolute;left:0;top:9px;width:14px;height:14px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#e8d3a6,var(--gold) 70%)}
.lp-role .lp-ctas{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px}
.lp-price-line{font:500 14px Inter;color:var(--mute);margin-top:16px}

/* proof */
.lp-proof{padding:120px 0;background:linear-gradient(180deg,var(--cream),#f3eee6)}
.lp-phones{display:grid;grid-template-columns:repeat(3,1fr);gap:34px;margin-top:64px}
.lp-phone{text-align:center}
.lp-phone .frame{margin:0 auto;width:min(270px,100%);aspect-ratio:9/19.3;border-radius:42px;padding:10px;background:#121222;box-shadow:0 40px 70px rgba(26,26,46,.25);overflow:hidden}
.lp-phone .frame img{width:100%;height:100%;object-fit:cover;object-position:top;border-radius:33px;display:block}
.lp-phone h3{font:600 22px 'Playfair Display',serif;margin:28px 0 8px;color:var(--ink)}
.lp-phone p{font:400 15px/1.6 Inter;color:var(--ink2);max-width:300px;margin:0 auto}

/* AI */
.lp-ai{padding:120px 0}
.lp-ai .lp-wrap{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center}
.lp-ai-card{max-width:430px;margin:0 auto;border-radius:28px;overflow:hidden;box-shadow:0 40px 80px rgba(26,26,46,.14);background:#fff;border:1px solid var(--line)}
.lp-ai-card video{width:100%;display:block}
.lp-ai ul{margin:22px 0 0;padding:0 0 0 20px;color:var(--ink2);font:400 16px/1.75 Inter}
.lp-url{display:flex;align-items:center;gap:10px;margin-top:24px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:8px 8px 8px 18px;max-width:440px}
.lp-url code{font:500 15px ui-monospace,'SF Mono',Menlo,monospace;color:var(--ink);flex:1}
.lp-url button{font:600 13px Inter;border:0;background:var(--ink);color:#fff;padding:10px 14px;border-radius:10px;cursor:pointer}
.lp-small{font:400 14px/1.6 Inter;color:var(--mute);margin-top:14px}
.lp-small a{color:var(--gold-d);font-weight:600}

/* pricing */
.lp-pricing{padding:110px 0;background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.lp-prices{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:56px}
.lp-pcard{border:1px solid var(--line);border-radius:var(--r);padding:32px;background:var(--cream)}
.lp-pcard h3{font:600 26px 'Playfair Display',serif;margin:0;color:var(--ink)}
.lp-pcard .who{font:500 14px Inter;color:var(--mute);margin:6px 0 20px}
.lp-tier{display:flex;justify-content:space-between;gap:14px;padding:14px 0;border-top:1px solid var(--line);font:400 14.5px/1.5 Inter;color:var(--ink2)}
.lp-tier b{color:var(--ink);font-weight:600}
.lp-tier .amt{white-space:nowrap;font-weight:600;color:var(--gold-d)}
.lp-pcard .lp-btn{margin-top:20px}

/* story + faq + cta */
.lp-story{padding:110px 0}
.lp-story .lp-wrap{display:grid;grid-template-columns:.9fr 1.1fr;gap:72px;align-items:center}
.lp-quote{font:500 italic clamp(26px,2.6vw,36px)/1.35 'Playfair Display',serif;color:var(--ink)}
.lp-faq{padding:40px 0 110px}
.lp-faq details{border-top:1px solid var(--line);max-width:820px;margin:0 auto}
.lp-faq details:last-child{border-bottom:1px solid var(--line)}
.lp-faq summary{list-style:none;cursor:pointer;padding:22px 44px 22px 2px;position:relative;font:600 19px/1.4 'Playfair Display',serif;color:var(--ink)}
.lp-faq summary::-webkit-details-marker{display:none}
.lp-faq summary::after{content:"+";position:absolute;right:6px;top:18px;font:300 28px Inter;color:var(--gold-d)}
.lp-faq details[open] summary::after{content:"–"}
.lp-faq details p{margin:0 2px 22px;font:400 16px/1.7 Inter;color:var(--ink2);max-width:72ch}
.lp-final{position:relative;padding:130px 0;text-align:center;overflow:hidden;background:#151527;color:#fff}
.lp-final video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.35}
.lp-final .lp-wrap{position:relative}
.lp-final h2{font:600 clamp(38px,5vw,64px)/1.05 'Playfair Display',serif;margin:0;color:#fff}
.lp-final h2 em{color:var(--gold);font-weight:500}
.lp-final p{font:400 18px/1.6 Inter;color:rgba(255,255,255,.8);max-width:560px;margin:20px auto 0}
.lp-final .lp-badges{justify-content:center;margin-top:30px}
.lp-final form{margin-top:48px}
.lp-final .att-inline-form{display:flex;gap:10px;max-width:480px;margin:0 auto}
.lp-final .att-input{flex:1;padding:14px 16px;border-radius:12px;border:1px solid rgba(255,255,255,.25);background:rgba(255,255,255,.08);color:#fff;font:400 15px Inter}
.lp-final .att-consent{display:flex;gap:10px;font:400 13px/1.5 Inter;color:rgba(255,255,255,.7);max-width:520px;margin:14px auto 0;text-align:left}
.lp-final .att-consent a{color:var(--gold)}

/* responsive */
@media (max-width:980px){
  .lp-links{display:none}
  .lp-links.open{display:flex;position:absolute;top:74px;left:0;right:0;flex-direction:column;align-items:flex-start;gap:18px;padding:24px 28px;background:var(--cream);box-shadow:0 20px 40px rgba(26,26,46,.1)}
  .lp-burger{display:block}
  .lp-pgrid,.lp-phones,.lp-prices{grid-template-columns:1fr}
  .lp-role .lp-wrap,.lp-ai .lp-wrap,.lp-story .lp-wrap{grid-template-columns:1fr;gap:36px}
  .lp-role.flip .lp-media{order:0}
}
@media (max-width:700px){
  .lp-wrap{padding:0 20px}
  .lp-hero .v-desktop{display:none}.lp-hero .v-mobile{display:block}
  .lp-hero::after{background:linear-gradient(0deg,rgba(250,248,245,.97) 0%,rgba(250,248,245,.88) 46%,rgba(250,248,245,.35) 64%,rgba(250,248,245,0) 78%)}
  .lp-hero-in{padding:120px 0 40px}
  .lp-roles{display:flex;width:100%}.lp-roles button{flex:1;padding:11px 8px;font-size:13px}
  .lp-scroll{display:none}
  .lp-tile{width:160px}
  .lp-final .att-inline-form{flex-direction:column}
}
@media (prefers-reduced-motion:reduce){.lp-marquee{animation:none}.lp-reveal{opacity:1;transform:none}}
</style>
</head>
<body class="lp">

<nav class="lp-nav" id="nav" aria-label="Main">
  <div class="lp-wrap">
    <a href="/" class="lp-logo" aria-label="Attesté home">Attest<span>é</span></a>
    <ul class="lp-links" id="lp-links">
      <li><a href="#collectors">Collectors</a></li>
      <li><a href="#artists">Artists</a></li>
      <li><a href="#galleries">Galleries</a></li>
      <li><a href="#ask-ai">Ask your AI</a></li>
      <li><a href="#pricing">Pricing</a></li>
      <li><a href="#download" class="lp-btn lp-btn-dark">Get the app</a></li>
    </ul>
    <button class="lp-burger" aria-label="Menu" aria-controls="lp-links" aria-expanded="false"><span></span><span></span><span></span></button>
  </div>
</nav>

<!-- HERO: our own demo paintings on a gallery wall, brought to life with Higgsfield (Kling 3.0 Turbo), 2026-10-25 -->
<header class="lp-hero" id="top">
  <video class="v-desktop" autoplay muted loop playsinline preload="auto" poster="assets/landing/hero.jpg" aria-hidden="true">
    <source src="assets/landing/hero.mp4" type="video/mp4">
  </video>
  <video class="v-mobile" autoplay muted loop playsinline preload="metadata" poster="assets/landing/hero-mobile.jpg" aria-hidden="true">
    <source src="assets/landing/hero-mobile.mp4" type="video/mp4">
  </video>
  <div class="lp-hero-in">
    <div class="lp-wrap">
      <div class="lp-hero-copy">
        <div class="lp-eyebrow">For collectors, artists &amp; galleries</div>
        <h1 class="lp-h1">Your art, <em>connected.</em></h1>
        <p class="lp-hero-sub" data-claim="f-shared-cert-view f-shared-cert-verify-result f-agent-connector-t0-verify">Give every work a signed certificate anyone can check, keep its whole story in one place, and ask the AI you already use to look it up for you.</p>

        <div class="lp-roles" role="tablist" aria-label="I am">
          <button role="tab" id="t-col" aria-controls="p-col" aria-selected="true">I collect</button>
          <button role="tab" id="t-art" aria-controls="p-art" aria-selected="false">I make art</button>
          <button role="tab" id="t-gal" aria-controls="p-gal" aria-selected="false">I run a gallery</button>
        </div>
        <div class="lp-role-panel" id="p-col" role="tabpanel" aria-labelledby="t-col">
          <p>Photograph the invoice, keep the paperwork with the work, and export one tidy PDF when the insurer asks. Free for your first 25 works.</p>
          <div class="lp-badges">
            <a href="https://apps.apple.com/app/apple-store/id6763944507?pt=128824584&amp;ct=website-hero&amp;mt=8" target="_blank" rel="noopener" aria-label="Download Attesté on the App Store"><img src="assets/badges/app-store-badge.svg" alt="Download on the App Store" width="138" height="46"></a>
            <a href="https://play.google.com/store/apps/details?id=art.atteste.atteste&amp;referrer=utm_source%3Dwebsite%26utm_medium%3Dhero" target="_blank" rel="noopener" aria-label="Get Attesté on Google Play"><img src="assets/badges/google-play-badge.png" alt="Get it on Google Play" width="155" height="46"></a>
          </div>
        </div>
        <div class="lp-role-panel" id="p-art" role="tabpanel" aria-labelledby="t-art" hidden>
          <p>Issue source certificates from the studio and show your work on a public page at atteste.art/artist/<em>your-name</em>. 14-day free trial.</p>
          <div class="lp-badges"><a class="lp-btn lp-btn-dark" href="artists.html">For artists &rarr;</a></div>
        </div>
        <div class="lp-role-panel" id="p-gal" role="tabpanel" aria-labelledby="t-gal" hidden>
          <p>Wake up to a daily Pulse briefing, an AI concierge that knows your inventory by name, and a place in the in-app gallery directory.</p>
          <div class="lp-badges"><a class="lp-btn lp-btn-dark" href="https://galleria.atteste.art" target="_blank" rel="noopener">Launch Galleria &rarr;</a><a class="lp-btn lp-btn-line" href="galleries.html">For galleries</a></div>
        </div>
        <p class="lp-hero-note">Paintings from the Attesté demo collection, brought to life with AI.</p>
      </div>
    </div>
  </div>
  <div class="lp-scroll" aria-hidden="true">Scroll</div>
</header>

<!-- LIVING STRIP -->
<section class="lp-strip" aria-labelledby="strip-h">
  <div class="lp-wrap lp-strip-head lp-reveal">
    <div>
      <div class="lp-eyebrow">Every work has a story</div>
      <h2 class="lp-h2" id="strip-h">Keep it with the work, <em>for good.</em></h2>
    </div>
    <p class="lp-lede" style="max-width:420px">Make it, buy it, hang it, lend it, pass it on. Attesté keeps the record straight at every step, so the story of a work never depends on someone finding the right email.</p>
  </div>
  <div class="lp-marquee" aria-hidden="true">
    <!--TILES-->
  </div>
  <div class="lp-wrap"><p class="lp-strip-note">AI-animated works from the Attesté demo collection.</p></div>
</section>

<!-- PILLARS (claim-gated, G12) -->
<section class="lp-pillars" id="connected">
  <div class="lp-wrap">
    <div class="lp-reveal">
      <div class="lp-eyebrow">From studio to wall, and onwards</div>
      <h2 class="lp-h2">One place for the whole life of a <em>work of art.</em></h2>
    </div>
    <div class="lp-pgrid">
      <div class="lp-pillar lp-reveal" data-claim="f-shared-cert-view f-shared-cert-verify-result">
        <div class="lp-verb">Prove<span>.</span></div>
        <div class="lp-what">A certificate anyone can check</div>
        <p>Every work gets an Attesté certificate, signed when it&rsquo;s issued and timestamped on Bitcoin. Share the link or the QR code; whoever opens it sees whether the record still matches, with no account and no app.</p>
      </div>
      <div class="lp-pillar lp-reveal" data-claim="f-collector-collection-list f-collector-condition-vault f-collector-insurance-vault">
        <div class="lp-verb">Own<span>.</span></div>
        <div class="lp-what">The paperwork, finally in one place</div>
        <p>Invoices, condition notes and valuations live with the work they belong to. When the insurer asks, you export one tidy PDF instead of an afternoon in the filing cabinet.</p>
      </div>
      <div class="lp-pillar lp-reveal" data-claim="a-041-public-artist-profile g-001-directory-listing">
        <div class="lp-verb">Show<span>.</span></div>
        <div class="lp-what">Out in the world</div>
        <p>Artists get a public page at atteste.art/artist/<em>their-name</em>, with their works and certificates on it. Galleries get a place in the gallery directory inside the app, where collectors browse before a Saturday of gallery-hopping.</p>
      </div>
      <div class="lp-pillar lp-reveal" data-claim="a-032-provenance-transfer f-shared-transfers-hub">
        <div class="lp-verb">Pass it on<span>.</span></div>
        <div class="lp-what">The record travels with the work</div>
        <p>Sold, gifted or consigned, the work&rsquo;s record moves to its next owner, and every hand-over is signed and added to the chain.</p>
      </div>
      <div class="lp-pillar lp-reveal" data-claim="g-111-trade-payments a-055-trade-payments">
        <div class="lp-verb">Sell<span>.</span></div>
        <div class="lp-what">No more wire-and-pray</div>
        <p>Sell inside Attesté. The buyer pays a licensed escrow service, not a stranger&rsquo;s bank account, and the money is released once the buyer confirms the work arrived. Ownership and the certificate move to the buyer at the same time.</p>
        <a href="sell.html">How selling works &rarr;</a>
      </div>
      <div class="lp-pillar lp-reveal" data-claim="f-agent-connector-t0-verify">
        <div class="lp-verb">Ask<span>.</span></div>
        <div class="lp-what">From the AI you already use</div>
        <p>Plug Attesté into any assistant that supports MCP, paste a certificate link, and ask. It checks the signature, the Bitcoin timestamp and the ownership history for you, and says plainly what that does and doesn&rsquo;t prove.</p>
        <a href="#ask-ai">Connect your AI &darr;</a>
      </div>
    </div>
  </div>
</section>

<!-- COLLECTORS -->
<section class="lp-role" id="collectors">
  <div class="lp-wrap">
    <div class="lp-media lp-reveal">
      <video muted loop playsinline preload="none" data-ambient poster="assets/landing/scene-collector.jpg" aria-hidden="true"><source src="assets/landing/scene-collector.mp4" type="video/mp4"></video>
      <span class="lp-chip">For collectors</span>
    </div>
    <div class="lp-reveal">
      <div class="lp-eyebrow">Collectors</div>
      <h2 class="lp-h2">The art is real. <em>Now the archive is too.</em></h2>
      <ul>
        <li data-claim="f-shared-document-ocr-autofill"><strong>Snap the invoice.</strong> Price, seller and date fill themselves in for you to check.</li>
        <li data-claim="f-collector-collection-list f-collector-insurance-vault"><strong>See the gaps.</strong> The vault shows which works have no policy and no condition report, and exports the schedule your broker asks for.</li>
        <li data-claim="f-shared-cert-view f-shared-cert-verify-result"><strong>Prove it, anywhere.</strong> A certificate anyone can open from a link or a QR code.</li>
        <li data-claim="f-collector-add-discovery-flow"><strong>Fall for a painting with no label?</strong> Photograph it with Quick Discovery and read about its style, technique and context.</li>
      </ul>
      <div class="lp-ctas"><a class="lp-btn lp-btn-dark" href="#download">Start free</a><a class="lp-btn lp-btn-line" href="features.html">All features</a></div>
      <p class="lp-price-line">Free for 25 works &middot; Collector $9.99/mo &middot; Premium $19.99/mo</p>
    </div>
  </div>
</section>

